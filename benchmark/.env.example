# FreshSearch benchmark: local provider settings.
# Copy this file to .env (never commit .env) and uncomment only the providers you run.
# Load it with `node --env-file=.env run.mjs ...` or `node --env-file=.env evaluate.mjs ...`.
# Variables already set in your terminal take precedence over values in this file.

# WebIQ and WebIQ Auto (providers/webiq.mjs, providers/webiq-auto.mjs) share one key.
# WEBIQ_API_KEY=""
# Optional HTTPS overrides of the built-in public endpoints
# (https://api.microsoft.ai/v3/search/web and https://api.microsoft.ai/v3/auto).
# WEBIQ_ENDPOINT=""
# WEBIQ_AUTO_ENDPOINT=""

# Perplexity (providers/perplexity.mjs)
# PERPLEXITY_API_KEY=""

# Exa Auto (providers/exa-auto.mjs)
# EXA_API_KEY=""

# Parallel (providers/parallel.mjs)
# PARALLEL_API_KEY=""

# Custom adapter example (examples/provider.mjs)
# FRESHSEARCH_PROVIDER_ENDPOINT=""
# FRESHSEARCH_PROVIDER_KEY=""

# Azure OpenAI judge templates: resource base URL, unless set in local-judge.json.
# AZURE_OPENAI_ENDPOINT=""

# Prefer entering judge API keys (FRESHSEARCH_JUDGE_API_KEY or AZURE_OPENAI_KEY)
# with hidden terminal input instead of storing them here; see "Enter your judge
# key" in the root README.
